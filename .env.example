# 复制为 .env 后填写。.env 不要提交到仓库。

# 模型供应商二选一：deepseek（deepseek-flash）或 glm（智谱 GLM-5.3-Flash）。
# 也可以在前端右上角「模型设置」里选择并填写密钥，页面会改写这个文件，不用重启
LLM_PROVIDER=deepseek
# 密钥：填当前供应商对应的那一项。LLM_API_KEY 填了就优先用它
# 智谱要用标准 API 的密钥并有账户余额：按条款，GLM Coding Plan 的额度不能用在自建应用里
DEEPSEEK_API_KEY=
ZHIPUAI_API_KEY=
# 设为 false 只走规则兜底（断网演示 / CI）
LLM_ENABLED=true
# 固定流程（查余额、给我妈转 500、锁卡……）走确定性工作流、不调模型；设为 false 全部交给模型（对比评测用）
WORKFLOW_ENABLED=true

# 下面几项不填就用供应商预设，需要时取消注释覆盖
# LLM_MODEL=glm-5.3-flashx
# LLM_BASE_URL=
# 思考模式：deepseek 预设 disabled（工具调用延迟低）；glm-5.3-flash 只能 enabled
# LLM_THINKING=
# 思考强度：glm 预设 low（演示要快），可选 low / high / max；deepseek 预设不传
# LLM_REASONING_EFFORT=
# LLM_TEMPERATURE=
# LLM_MAX_TOKENS=
# LLM_TIMEOUT_S=

# 知识库向量检索（可选）：留空只用 BM25 关键词检索，和不配一模一样。
# 填 siliconflow 用硅基流动 Qwen/Qwen3-Embedding-8B（1024 维），和 BM25 混合排序；接口超时（2 秒）或出错时自动回到 BM25。
# 条目向量缓存在 data/kb_embeddings.json（不提交），条目改了会自动重算
# EMBEDDING_PROVIDER=siliconflow
# SILICONFLOW_API_KEY=
# 也可以用千问 / 阿里云百炼 text-embedding-v4（EMBEDDING_PROVIDER=qwen，用下面的 DASHSCOPE_API_KEY；未实测），
# 智谱 embedding-3（EMBEDDING_PROVIDER=zhipu，复用上面的 ZHIPUAI_API_KEY，需要账户余额），
# 或任意 OpenAI 兼容接口（EMBEDDING_PROVIDER=openai，再填下面几项）
# DASHSCOPE_API_KEY=
# EMBEDDING_BASE_URL=
# EMBEDDING_MODEL=
# EMBEDDING_API_KEY=
# EMBEDDING_DIMENSIONS=
# EMBEDDING_TIMEOUT_S=2

# 知识库重排模型（可选，和向量检索互相独立，都不强制）：留空不重排，和不配一模一样。
# 填 siliconflow 用硅基流动 Qwen/Qwen3-Reranker-4B（准确率和 8B 打平）：检索出的前 10 条候选逐条打相关性分，按分数排序，最高分过门槛才算查到；
# 复用上面的 SILICONFLOW_API_KEY。接口超时（3 秒）或出错时这一问不重排。只配重排、不配向量也能用（候选来自关键词检索）
# RERANK_PROVIDER=siliconflow
# 也可以用千问 / 阿里云百炼 qwen3-rerank（RERANK_PROVIDER=qwen，用 DASHSCOPE_API_KEY；未实测，门槛未校准）
# RERANK_API_KEY=
# RERANK_MODEL=
# RERANK_BASE_URL=
# RERANK_MIN_SCORE=
# RERANK_TIMEOUT_S=3

# 知识库 agentic 重查：原话没查到时，让上面配的对话模型把问题改写成 1–2 个书面说法再查一次（默认开，要对话模型可用）。
# 没查到的问题（含超范围问题）多等一次模型调用，实测约 2 秒；改写超时（6 秒）或出错就照常回「没查到」
# KB_AGENTIC_RETRY=true
# KB_REWRITE_TIMEOUT_S=6

# 数据库：不填就用仓库根目录的 SQLite 文件 data/dev.db。
# 要换 SQLite 文件请写绝对路径（sqlite:/// 后面的相对路径按后端工作目录 apps/api 算）；
# 切 PostgreSQL 改成 postgresql+psycopg://user:pass@host/db
# DATABASE_URL=sqlite:////绝对路径/dev.db

# 签发执行令牌和验证码用的密钥，正式演示前换成随机串：python3 -c "import secrets;print(secrets.token_hex(32))"
APP_SECRET=dev-only-secret-change-me

# 运营后台口令（/admin 接口和前端「运营后台」「模型设置」都要用）。不设时只在演示模式下开放
ADMIN_PASSWORD=

# 演示模式：模拟短信内容直接显示在页面上；开放 /dev 接口（重置数据、时间快进）
DEMO_MODE=true

# 企业微信智能机器人（可选，README「企业微信渠道」）：管理后台 → 智能机器人 → API 模式 → 长连接，
# 把 BotID 和 Secret 填在这里，两项都填了后端启动时才会连企业微信。IM 里只做只读查询，需要确认的操作引导到 App
WECOM_BOT_ID=
WECOM_BOT_SECRET=
# 企业微信用户默认绑定的演示用户（不填用 DEMO_USER_ID=1）；白名单为空表示企业内成员都能用
# WECOM_BIND_USER_ID=1
# WECOM_ALLOWED_USERS=zhangsan,lisi
# IM 里引导用户去办理的言行 App 地址（手机上点开要能访问，演示时可改成电脑的局域网 IP）
# APP_H5_URL=http://127.0.0.1:5173
# 默认直连企业微信、不走系统代理；必须走代理时填，如 http://127.0.0.1:7890
# WECOM_PROXY=
