# 复制为 .env 后填写。.env 不要提交到仓库。

# 模型供应商二选一：deepseek（deepseek-flash）或 glm（智谱 GLM-5.3-Flash）。
# 也可以在前端右上角「模型设置」里选择并填写密钥，页面会改写这个文件，不用重启
LLM_PROVIDER=deepseek
# 密钥：填当前供应商对应的那一项。LLM_API_KEY 填了就优先用它
# 智谱要用标准 API 的密钥并有账户余额：按条款，GLM Coding Plan 的额度不能用在自建应用里
DEEPSEEK_API_KEY=
ZHIPUAI_API_KEY=
# 设为 false 只走规则兜底（断网演示 / CI）
LLM_ENABLED=true

# 下面几项不填就用供应商预设，需要时取消注释覆盖
# LLM_MODEL=glm-5.3-flashx
# LLM_BASE_URL=
# 思考模式：deepseek 预设 disabled（工具调用延迟低）；glm-5.3-flash 只能 enabled
# LLM_THINKING=
# 思考强度：glm 预设 low（演示要快），可选 low / high / max；deepseek 预设不传
# LLM_REASONING_EFFORT=
# LLM_TEMPERATURE=
# LLM_MAX_TOKENS=
# LLM_TIMEOUT_S=

# 数据库：不填就用仓库根目录的 SQLite 文件 data/dev.db。
# 要换 SQLite 文件请写绝对路径（sqlite:/// 后面的相对路径按后端工作目录 apps/api 算）；
# 切 PostgreSQL 改成 postgresql+psycopg://user:pass@host/db
# DATABASE_URL=sqlite:////绝对路径/dev.db

# 签发执行令牌和验证码用的密钥，正式演示前换成随机串：python3 -c "import secrets;print(secrets.token_hex(32))"
APP_SECRET=dev-only-secret-change-me

# 运营后台口令（/admin 接口和前端「运营后台」「模型设置」都要用）。不设时只在演示模式下开放
ADMIN_PASSWORD=

# 演示模式：模拟短信内容直接显示在页面上；开放 /dev 接口（重置数据、时间快进）
DEMO_MODE=true
